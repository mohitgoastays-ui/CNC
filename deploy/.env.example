# Relief Studio — Environment Configuration
# Copy to .env and fill in real values before deploying.

# ---- Core ----
# ENV=production makes the API REFUSE to boot with the default SECRET_KEY or a
# wildcard CORS origin, rather than silently running with forgeable tokens.
ENV=dev
SECRET_KEY=change-this-to-a-random-64-char-string
DATABASE_URL=postgresql://relief:relief@localhost:5432/relief
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed origins. Must be explicit when ENV=production.
CORS_ORIGINS=*

# Run queued jobs inline in the API process when Redis is unreachable.
# Defaults to on in dev, OFF in production — otherwise a Redis blip turns the
# thin API into an unbounded CPU worker.
ALLOW_INLINE_JOBS=1

# Hard cap on the JSON job payload (it carries the flattened heightfield).
MAX_JOB_SETTINGS_MB=16

# Login throttle (per client IP + email).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SEC=300

# Worker retries before a job goes to the relief:jobs:dead list.
WORKER_MAX_RETRIES=3

# ---- S3 / Object Storage ----
S3_BUCKET=relief-studio-files
S3_ENDPOINT=                     # leave empty for AWS; set to http://minio:9000 for MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1    # Mumbai — closest to your base

# ---- Stripe Billing (Phase 5) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ---- Frontend ----
FRONTEND_URL=https://relief.karvixai.com

# ---- Limits ----
FREE_HEAVY_JOBS=3                # free-tier server jobs per day
PRO_HEAVY_JOBS=100               # pro-tier server jobs per day
MAX_UPLOAD_MB=50

# ---- AI Depth Worker (Phase 4 GPU, optional) ----
AI_DEPTH_MODEL=depth_anything_v2  # depth_anything_v2 | midas_v3 | luminosity_fallback
